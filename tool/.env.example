# LiemWhisper Data Collection Platform Environment Config
# Sao chép file này thành .env và chỉnh sửa theo môi trường của bạn

# Môi trường chạy
APP_ENV=production

# URL công khai của Backend API (dùng cho frontend kết nối)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL công khai của Frontend (để cấu hình CORS, có thể để * nếu mở cho mọi domain/IP)
WEB_PUBLIC_URL=*

# Khóa quản trị Admin (Bắt buộc bảo mật khi triển khai cho người thật)
ADMIN_API_KEY=replace_with_a_random_secret_before_deployment

# Danh sách Gmail quản trị viên ban đầu (phân cách bằng dấu phẩy, ví dụ: admin@gmail.com,teacher@gmail.com)
ADMIN_EMAILS=

# Lưu trữ dữ liệu
# STORAGE_BACKEND: 'local' (lưu file đĩa), 'sql' (lưu toàn bộ audio trong database), 'sql_drive' (lưu SQL + đồng bộ Google Drive)
STORAGE_BACKEND=sql_drive
DATA_ROOT=./data
MAX_AUDIO_BYTES=15000000

# Database URL: Để trống sẽ dùng SQLite (private-data/collection.sqlite3); hoặc điền PostgreSQL (Render Postgres / Supabase / Neon)
DATABASE_URL=

# Google Drive OAuth (Cho chế độ lưu trữ sql_drive với Google Drive cá nhân)
# Sinh TOKEN_ENCRYPTION_KEY bằng lệnh: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Google Sign-In & Google Drive OAuth
# Client ID dùng chung cho Google Sign-in ở Frontend và Backend xác thực token
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/admin/drive/callback

# Gửi thư cảm ơn tự động qua Gmail SMTP (App Password 16 ký tự của Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Dự án NCKH LiemWhisper
SMTP_FROM_EMAIL=
